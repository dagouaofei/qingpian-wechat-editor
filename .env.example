# Volcengine / Doubao model provider (S5-STORY-005)
# Copy to `.env.local` for local development. Never commit real secrets.

# Enable the real Volcengine provider at runtime (default: disabled)
VOLCENGINE_ENABLE_REAL_PROVIDER=false

# Volcengine Ark API key (Bearer token)
VOLCENGINE_API_KEY=

# Volcengine Ark chat completions base URL
# Default: https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_BASE_URL=

# Endpoint model name / endpoint id, e.g. doubao-pro-32k or an Ark endpoint id
VOLCENGINE_MODEL=

# Request timeout in milliseconds (default: 60000)
VOLCENGINE_TIMEOUT_MS=
