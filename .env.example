# Volcengine / Doubao model provider (S5-STORY-005)
# Copy to `.env.local` for local development. Never commit real secrets.

# Enable the real Volcengine provider at runtime (default: disabled)
VOLCENGINE_ENABLE_REAL_PROVIDER=false

# Volcengine Ark API key (Bearer token)
VOLCENGINE_API_KEY=

# Volcengine Ark chat completions base URL
# Default: https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_BASE_URL=

# Endpoint model name / endpoint id, e.g. doubao-pro-32k or an Ark endpoint id
VOLCENGINE_MODEL=

# Request timeout in milliseconds (default: 60000)
VOLCENGINE_TIMEOUT_MS=

# Dev-only real API smoke (S5-STORY-005A):
#   corepack pnpm smoke:volcengine-provider
# Requires VOLCENGINE_ENABLE_REAL_PROVIDER=true plus API key and model above.
# Not run in CI / pnpm test.

# PostgreSQL for S10 database-backed style admin (S10-STORY-002+)
# Use local Docker / dev PostgreSQL only. Never commit real RDS credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# S10 single-admin authentication (S10-STORY-008+)
# Generate password hash: corepack pnpm style-admin:hash-password "your-password"
# Generate session secret: openssl rand -base64 48
STYLE_ADMIN_USERNAME="admin"
STYLE_ADMIN_PASSWORD_HASH="CHANGE_ME_GENERATED_HASH"
STYLE_ADMIN_SESSION_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
STYLE_ADMIN_SESSION_TTL_SECONDS="86400"

# Production write guard (S10-STORY-006+). Local dev/test default allows writes for authenticated admins.
STYLE_ADMIN_WRITE_ENABLED="false"

# User-selectable variant pool cache TTL in seconds (S10-STORY-005+). Default 120, max 300.
STYLE_ADMIN_USER_POOL_CACHE_TTL_SECONDS="120"

# Harvest WeChat Compatibility Spec mode (S10-STORY-011 diagnostic switch).
# off = sanitize only (script/event removal); report = issues only, no downgrade (default); enforce = strict transform/blocking.
STYLE_HARVEST_WECHAT_COMPATIBILITY_MODE="report"

# Aliyun OSS (reserved for S10-STORY-009~011 evidence). Do not commit real credentials.
# OSS_REGION="cn-beijing"
# OSS_BUCKET="qingpian-style-evidence"
# OSS_ACCESS_KEY_ID="CHANGE_ME"
# OSS_ACCESS_KEY_SECRET="CHANGE_ME"
